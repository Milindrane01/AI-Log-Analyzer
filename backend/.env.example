# Copy to .env and fill in. NEVER commit .env — only this example file.
# All app settings use the APP_ prefix (see app/core/config.py).

APP_ENVIRONMENT=development        # development | test | production
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=false                 # false = pretty console (dev), true = JSON (prod)

# --- Auth (Milestone 2) ---
# REQUIRED in production; dev default is refused at boot there.
APP_JWT_SECRET_KEY=dev-secret-do-not-use-in-prod
APP_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (Milestone 2) ---
# In compose, host is the service name `postgres`; outside compose, localhost.
APP_DATABASE_URL=postgresql+asyncpg://loganalyzer:change-me-in-dev-too@postgres:5432/loganalyzer

# --- AI (Milestone 4) ---
# Leave empty to run without AI (analyses complete with groups, no insights).
APP_OPENAI_API_KEY=
APP_OPENAI_MODEL_CHEAP=gpt-4o-mini
APP_OPENAI_MODEL_STRONG=gpt-4o
APP_AI_MAX_GROUPS_PER_ANALYSIS=10

# Milestones 6-8 (frontend, chat, reports) add no new backend env vars.

# --- Similarity search (Milestone 5) ---
# Empty = similarity disabled. In compose: http://qdrant:6333
APP_QDRANT_URL=http://qdrant:6333
# hashing (no deps, token-overlap) | sentence-transformers (semantic, needs torch)
APP_EMBEDDING_BACKEND=hashing
APP_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ingestion (Milestone 3) ---
APP_REDIS_URL=redis://redis:6379/0
APP_UPLOAD_DIR=/srv/uploads
APP_MAX_UPLOAD_BYTES=52428800
APP_MAX_PASTE_BYTES=1048576

# --- Used by docker-compose ---
POSTGRES_USER=loganalyzer
POSTGRES_PASSWORD=change-me-in-dev-too
POSTGRES_DB=loganalyzer
