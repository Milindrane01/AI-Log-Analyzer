# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

aws_region    = "us-east-1"
project_name  = "ai-log-analyzer"
instance_type = "t3.large"

# Paste the CONTENTS of your PUBLIC key (e.g. `cat ~/.ssh/id_ed25519.pub`).
# Keep the matching PRIVATE key for SSH / the GitHub EC2_SSH_KEY secret.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Lock these down to your own IP for anything beyond a throwaway demo.
ssh_allowed_cidr  = "0.0.0.0/0"
http_allowed_cidr = "0.0.0.0/0"

# Leave false for the basic POC (frontend served by Nginx on EC2).
enable_s3_frontend = false
